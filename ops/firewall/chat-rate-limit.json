{
  "name": "chat-rate-limit",
  "description": "POST /api/chat: IP başına 10 dk'da 6 istek, aşımda 429 (Groq günlük kota koruması). Tanımın kaynağı repo: ops/firewall/chat-rate-limit.json — elle düzenleme drift'tir.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "path", "op": "eq", "value": "/api/chat" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 600,
        "limit": 6,
        "keys": ["ip"],
        "action": "rate_limit"
      },
      "redirect": null,
      "actionDuration": null
    }
  }
}
